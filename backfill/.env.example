# Copy to backfill/.env and fill in.  DO NOT COMMIT the real .env.

# --- Sourcing project (backfill-po.mjs → sd_po_master_raw) ---
# Supabase → Project Settings → API:
SUPABASE_URL=https://jwqqifojsqcdrlquzwqr.supabase.co
SUPABASE_SERVICE_ROLE=<the service_role secret — NOT the anon/publishable key>

# --- NPD-Tracker v7 project (sync-extra.mjs → sd_inventory_planning, sd_po_grn_mapping) ---
# From the NPD-Tracker v7 project → Settings → API:
NPD_SUPABASE_URL=https://xntnqlrcxznximxbskut.supabase.co
NPD_SUPABASE_SERVICE_ROLE=<the NPD project service_role secret>

# BigQuery: the query bills to (and reads from) saadaa-wh. Leave as-is.
# Both scripts authenticate as you via `gcloud auth application-default login`.
BQ_BILLING_PROJECT=saadaa-wh
# backfill-grn-qc.mjs trailing window (days). Default 60 — wide enough to re-capture
# QC decisions that land after a GRN is created. Use `--full` to backfill all history.
GRN_LOOKBACK_DAYS=60

# --- EasyEcom direct API pull (fetch-ee-po.mjs → sd_ee_po) ---
# ROTATE the exposed password + X-API-KEY before using these.
EE_EMAIL=<easyecom api user, e.g. website@saadaa.in>
EE_PASSWORD=<easyecom password (rotated)>
EE_API_KEY=<easyecom X-API-KEY (rotated)>
EE_LOCATION_KEY=<a seed location key, e.g. wo11402395524 = SAADAA SUSTAINABLE>
EE_ALL_LOCATIONS=false          # true = loop every accessible warehouse, de-dupe by po_id
EE_START_DATE=2025-01-01 00:00:00

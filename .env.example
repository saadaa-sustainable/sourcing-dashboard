# SAADAA Sourcing Dashboard — local environment template.
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Only the two public keys belong here.
#
# Leave BOTH blank to run in local fixture mode — but note that fixture mode
# reads CSV exports from data/fixtures/, which contain real sourcing data and
# are gitignored (NOT shipped in the repo). A fresh clone must either point at
# Supabase (below) or drop the CSV exports into data/fixtures/ manually.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service-role / secret key here or in any NEXT_PUBLIC_ variable.
# It lives only in Apps Script Script Properties (see README → Apps Script sync).
